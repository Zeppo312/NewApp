<!doctype html><html lang="de"><head><meta charset="utf-8"><title>LottiBaby — Gemeinsam im Blick</title><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>
*{box-sizing:border-box;margin:0}html,body{width:1080px;height:1920px;overflow:hidden;background:#FFF8F0;color:#49362F;font-family:Manrope,sans-serif}#spot{width:1080px;height:1920px;position:relative;overflow:hidden}.scene{position:absolute;inset:0;background:#FFF8F0;overflow:hidden}.scene:not(#s1){opacity:0}.scene-content{width:100%;height:100%;padding:160px 80px 160px;display:flex;flex-direction:column;gap:30px;position:relative;z-index:2}.brand{font-size:35px;font-weight:700;letter-spacing:-1px;display:flex;align-items:center;gap:14px}.brand:before{content:'';width:13px;height:13px;background:#8E4EC6;border-radius:50%}.eyebrow{font-size:24px;letter-spacing:4px;text-transform:uppercase;color:#7D5A50;font-weight:700;margin-top:28px}h1,h2{font-family:Fraunces,serif;font-size:117px;font-weight:700;line-height:1.02;letter-spacing:-5px;max-width:910px}em{font-style:normal;color:#8E4EC6}.support{font-size:34px;line-height:1.4;max-width:880px}.product-space{flex:1;min-height:0;display:flex;justify-content:center;align-items:center;perspective:1800px}.phone{width:495px;height:920px;background:#382C3D;border:9px solid #493F49;border-radius:54px;padding:6px;box-shadow:0 35px 55px #49362F26;overflow:hidden;flex-shrink:0;position:relative;transform:rotate(-5deg)}.screen{width:100%;height:100%;overflow:hidden;border-radius:39px;position:relative;background:#FFF8F0}.screen img{width:100%;height:auto;display:block}.phone.day img{width:100%;}.phone.day{height:780px;transform:rotate(4deg)}.phone.day .screen img{transform:translateY(-65px)}.phone.small{width:440px;height:800px;transform:rotate(5deg)}.phone.small .screen img{width:100%;}.phone.hero{width:440px;height:820px;transform:rotate(-7deg)}.phone.hero .screen img{width:100%}.foot{font-size:25px;color:#7D5A50;letter-spacing:.3px}.orb{position:absolute;border:1px solid #D6BEDF;border-radius:50%;width:1180px;height:1180px;left:150px;top:600px}.wash{position:absolute;width:900px;height:1100px;left:320px;top:670px;background:#E8DDF1;border-radius:450px 450px 0 0;transform:rotate(-20deg);opacity:.65}.rail{position:absolute;left:80px;right:80px;bottom:105px;height:2px;background:#E8DDF1}.rail span{display:block;width:100%;height:100%;background:#8E4EC6;transform-origin:left;transform:scaleX(0)}.note{font-size:21px;color:#7D5A50}.pill{font-size:33px;font-weight:700;padding:24px 37px;background:#E8DDF1;border-radius:50px;color:#49362F;align-self:flex-start}.closing .scene-content{gap:28px}.closing h2{font-size:130px;max-width:750px}.closing .product-space{justify-content:flex-end;padding-right:30px}.closing .support{font-size:37px}.closing .eyebrow{margin-top:10px}
</style></head><body><div id="spot" data-composition-id="spot" data-start="0" data-duration="20" data-width="1080" data-height="1920">
<section class="scene" id="s1"><div class="wash" data-layout-ignore></div><div class="orb" data-layout-ignore></div><div class="scene-content"><div class="brand">LottiBaby</div><div class="eyebrow">Euer Babyalltag</div><h1>Wann war das letzte <em>Schläfchen?</em></h1><div class="product-space"><div class="phone hero"><div class="screen" data-layout-allow-overflow><img src="assets/schlaf-intro.png" alt="Echter LottiBaby Schlaftracker"></div></div></div><p class="support">Die kleinen Absprachen. Gemeinsam im Blick.</p></div></section>
<section class="scene" id="s2"><div class="wash" data-layout-ignore></div><div class="orb" data-layout-ignore></div><div class="scene-content"><div class="brand">LottiBaby</div><div class="eyebrow">01 / Schlaf</div><h2>Schlafzeiten <em>festhalten.</em></h2><p class="support">Ein Überblick über die Schläfchen.</p><div class="product-space"><div class="phone"><div class="screen" data-layout-allow-overflow><img src="assets/schlaf.png" alt="Schlafübersicht der App mit Testdaten"></div></div></div><p class="foot">Schlaftracker in LottiBaby</p></div></section>
<section class="scene" id="s3"><div class="wash" data-layout-ignore></div><div class="orb" data-layout-ignore></div><div class="scene-content"><div class="brand">LottiBaby</div><div class="eyebrow">02 / Unser Tag</div><h2>Euer Tag.<br><em>An einem Ort.</em></h2><p class="support">Mahlzeiten, Wickeln und kleine Alltagsmomente.</p><div class="product-space"><div class="phone day"><div class="screen" data-layout-allow-overflow><img src="assets/unser-tag.png" alt="Echte Unser-Tag-Ansicht, oberer Ausschnitt"></div></div></div><p class="foot">Für das, was ihr festhalten möchtet.</p></div></section>
<section class="scene closing" id="s4"><div class="wash" data-layout-ignore></div><div class="orb" data-layout-ignore></div><div class="scene-content"><div class="brand">LottiBaby</div><div class="eyebrow">03 / Gemeinsam</div><h2>Ein Baby.<br><em>Ein Team.</em></h2><p class="support">Accounts verbinden. Gemeinsam im Blick.</p><div class="product-space"><div class="phone small"><div class="screen" data-layout-allow-overflow><img src="assets/partner.png" alt="Echte Funktion Accounts verknüpfen"></div></div></div><div class="pill">LottiBaby entdecken ↗</div><p class="note">App-Ansichten aus dem Simulator</p></div></section>
<div class="rail" data-layout-ignore style="z-index:10"><span></span></div><audio id="music" src="assets/musik.wav" data-start="0" data-duration="20" data-track-index="5" data-volume="0.7"></audio></div>
<script>window.__timelines=window.__timelines||{};const tl=gsap.timeline({paused:true});const starts=[0,4,9,14];starts.forEach((s,i)=>{const p='#s'+(i+1);if(i){tl.to('#s'+i,{opacity:0,duration:.5,ease:'sine.inOut'},s);tl.to(p,{opacity:1,duration:.5,ease:'sine.inOut'},s);}tl.from(p+' .brand',{y:-15,opacity:0,duration:.35,ease:'power2.out'},s+.1);tl.from(p+' .eyebrow',{x:-25,opacity:0,duration:.4,ease:'power3.out'},s+.15);tl.from(p+' h1,'+p+' h2',{y:45,opacity:0,duration:.65,ease:'expo.out'},s+.2);tl.from(p+' .support',{x:25,opacity:0,duration:.55,ease:'sine.out'},s+.35);tl.from(p+' .phone',{y:85,rotationY:-10,opacity:0,scale:.93,duration:.85,ease:'power4.out'},s+.3);if(i>0)tl.from(p+' .foot,'+p+' .note,'+p+' .pill',{y:25,opacity:0,duration:.5,ease:'power1.out',stagger:.08},s+.5);tl.from(p+' .wash',{opacity:0,duration:.7,ease:'sine.out'},s+.1);tl.from(p+' .orb',{opacity:0,scale:.96,duration:.8,ease:'power1.out'},s+.1);tl.to(p+' .wash',{rotation:-16,x:-25,duration:i===3?6:5,ease:'sine.inOut'},s+.8);tl.to(p+' .orb',{scale:1.035,duration:5,ease:'sine.inOut'},s+.8);});tl.to('#s1 .phone',{rotation:-3,y:-10,duration:2.5,ease:'sine.inOut'},1.4);tl.to('#s2 .phone',{rotation:1,duration:3.2,ease:'sine.inOut'},5.2);tl.to('#s3 .phone',{rotation:0,y:-10,duration:3.4,ease:'sine.inOut'},10.3);tl.to('#s4 .phone',{rotation:1,duration:3.5,ease:'sine.inOut'},15.3);tl.to('.rail span',{scaleX:1,duration:20,ease:'none'},0);window.__timelines.spot=tl;</script></body></html>
