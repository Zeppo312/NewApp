index 0000000..dbdce85
--- /dev/null
+++ b/node_modules/react-native/Libraries/Text/defaultMaxFontSizeMultiplier.js
@@ -0,0 +1,27 @@
+/**
+ * LottiBaby-Patch: größenabhängige Obergrenze für die Systemschrift-Skalierung.
+ *
+ * React Native skaliert jede Schrift mit demselben Faktor (bis ~3.6x). iOS
+ * selbst skaliert Dynamic Type nichtlinear: Fließtext wächst stark, große
+ * Überschriften nur wenig. Diese Kurve bildet das nach: Text bis 16 pt darf
+ * auf 200 % wachsen, jeder Punkt darüber kommt nur noch zu 60 % dazu.
+ * Ein explizit gesetztes `maxFontSizeMultiplier` hat immer Vorrang.
+ *
+ * Gegenstück für Layout-Berechnungen: lib/fontScaling.ts (maxFontScaleFor).
+ *
+ * @flow strict
+ */
+
+const BODY_SIZE = 16;
+const BODY_MAX_SCALE = 2;
+const HEADING_GROWTH = 0.6;
+const MIN_SCALE = 1.1;
+
+export default function defaultMaxFontSizeMultiplier(fontSize: ?mixed): number {
+  if (typeof fontSize !== 'number' || !(fontSize > BODY_SIZE)) {
+    return BODY_MAX_SCALE;
+  }
+  const maxRendered =
+    BODY_SIZE * BODY_MAX_SCALE + (fontSize - BODY_SIZE) * HEADING_GROWTH;
+  return Math.max(MIN_SCALE, Math.round((maxRendered / fontSize) * 100) / 100);
+}
